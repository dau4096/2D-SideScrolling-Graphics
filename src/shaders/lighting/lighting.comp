/* lighting.comp */
#version 460 core


layout(local_size_x=8,  local_size_y=8,  local_size_z=8) in;


uniform ivec2 resolution;
uniform int numLights;
uniform sampler2D normalMap;


void main() {
	uvec2 pixelPosition = gl_GlobalInvocationID.xy;
	uint lightIndex = gl_GlobalInvocationID.z;
	if ((pixelPosition.x >= resolution.x) || (pixelPosition.y >= resolution.y) || (lightIndex >= numLights)) {return; /* Out of range. */}

	vec4 normalMapValue = texelFetch(normalMap, ivec2(pixelPosition), 0).rgba; //LOD 0.
	int surfaceType = int(normalMapValue.a);
	if (surfaceType < 0) {return; /* Surface is background. Do not do lighting here. */}
	//Do lighting stuff.
}

